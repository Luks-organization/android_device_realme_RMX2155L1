allow hal_dms_default hal_dms_default_exec:file { getattr execute entrypoint };
allow hal_dms_default hal_dms_default_exec:file { read open map };
allow hal_dms_default vendor_data_file:file { create unlink };
allow hal_dms_default vendor_data_file:file rw_file_perms;
allow hal_dms_default vendor_data_file:dir rw_dir_perms;
allow hal_dms_default vendor_data_file:dir { add_name remove_name };
allow hal_dms_default property_socket:sock_file write;
allow hal_dms_default init:unix_stream_socket connectto;

get_prop(hal_dms_default, vendor_mtk_audiohal_prop)
get_prop(hal_dms_default, vendor_mtk_audio_prop)
get_prop(hal_dms_default, vendor_audioserver_prop)

binder_call(hal_dms_default, priv_app)
