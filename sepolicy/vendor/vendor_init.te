dontaudit vendor_init vendor_userdir_file:dir write;
allow init hal_dms_default:process { siginh rlimitinh transition };
allow init hal_fingerprint_default:process ptrace;
allow vendor_init hal_audio_default:file rw_file_perms;
allow init oplus_block_device:blk_file relabelto;
allow init oplus_block_device:lnk_file relabelto;
allow vendor_init ccci_device:chr_file r_file_perms;
allow vendor_init vtservice_hidl:fd use;
allow vendor_init proc:file rw_file_perms;
allow vendor_init proc_sched_stune:file w_file_perms;
allow vendor_init proc_swappiness:file rw_file_perms;
allow vendor_init vendor_sysfs_usb_supply:dir search;
allow vendor_init vendor_sysfs_usb_supply:file { w_file_perms create_file_perms };
allow vendor_init vendor_sysfs_otg_switch:dir search;
allow vendor_init vendor_sysfs_otg_switch:file { w_file_perms create_file_perms };
allow vendor_init vendor_sysfs_battery_supply:dir search;
allow vendor_init vendor_sysfs_battery_supply:file rw_file_perms;
allow init vendor_proc_oplus_version:file r_file_perms;
allow vendor_init vendor_proc_display:file { rw_file_perms create_file_perms };
allow vendor_init vendor_proc_decimal:file w_file_perms;
allow vendor_init vendor_data_file:dir rw_dir_perms;
allow vendor_init vendor_proc_fastchg_fw:file w_file_perms;
allow vendor_init vendor_firmware_file:dir search;
allow vendor_init nfc_data_vendor_file:dir { r_dir_perms create_dir_perms };
allow vendor_init mtk_hal_videotelephony_hwservice:hwservice_manager find;
allow vendor_init hal_performance_oplus_hwservice:hwservice_manager find;
allow vendor_init mtk_radio_device:lnk_file unlink;
allow vendor_init sysfs_leds:file create_file_perms;
allow vendor_init sysfs_graphics:file { rw_file_perms create_file_perms };

rw_dir_file(vendor_init, sysfs_leds)

get_prop(vendor_init, system_mtk_camera_prop)
