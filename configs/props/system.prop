# AEE
ro.vendor.have_aee_feature=1

# APK Verity
ro.apk_verity.mode=2

# Audio
ro.audio.silent=0
ro.audio.usb.period_us=16000
ro.config.hd_voicemail=1
ro.config.media_vol_steps=15
ro.config.vc_call_vol_steps=7
ro.mtk_audenh_support=1
ro.mtk_audio_lossless_support=1
ro.mtk_besloudness_support=1

# Brand
Build.BRAND=MTK

# Camera
persist.camera.HAL3.enabled=1
persist.camera.eis.enable=1
ro.camera.sound.forced=0
ro.camera.hfr.enable=1
ro.camera.high.resolution.video.filter.enable=1
ro.camera.ignore.input.stream.check.enable=1
ro.camera.portrait.blur.level.enable=1
ro.camera.temperature.limit=440
ro.camera.videoeis.enable=
ro.mtk_cam.mfb.ultimate=1
ro.mtk_cam_dualzoom_support=1
ro.mtk_cam_stereo_camera_support=1

# Dalvik
dalvik.vm.systemuicompilerfilter=speed
dalvik.vm.image-dex2oat-filter=speed
dalvik.vm.dex2oat-filter=speed
dalvik.vm.dex2oat64.enabled=true

# Dex2oat
pm.dexopt.boot=verify
pm.dexopt.first-boot=verify
pm.dexopt.install=speed-profile
persist.bg.dexopt.enable=true

# Display
ro.hardware.egl=meow
ro.hardware.vulkan=mt6785
ro.hardware.hwcomposer=mt6785
ro.opengles.version=196610
ro.netflix.bsp_rev=MTK6785-18787-1
ro.mtk_display_ovl_support=1
ro.mtk_pq.ctrld_dpi_support=1
persist.sys.enable_mtk_scp_dump=1
persist.sys.sf.color_mode=9
persist.sys.sf.color_saturation=1.1
persist.sys.sf.native_mode=2
debug.mediatek.disp_decompress=1
debug.cpurend.vsync=false
debug.renderengine.backend=skiaglthreaded
qemu.hw.mainkeys=0

# HWUI
#debug.hwui.skia_use_perfetto_track_events=false
debug.hwui.render_dirty_regions=false
debug.hwui.skia_atrace_enabled=false
debug.hwui.skia_tracing_enabled=false
debug.hwui.target_cpu_time_percent=30
debug.hwui.trace_gpu_resources=false
debug.hwui.use_hint_manager=true
ro.hwui.disable_sc=false
ro.hwui.render_ahead=20

# SurfaceFlinger
#debug.sf.hw=0
#debug.egl.hw=0
debug.sf.disable_client_composition_cache=0
debug.sf.defer_refresh_rate_when_off=1
debug.sf.auto_latch_unsignaled=0
#debug.sf.enable_adpf_cpu_hint=true
debug.sf.enable_advanced_sf_phase_offset=1
#debug.sf.enable_auto_power_mode=1
debug.sf.enable_egl_image_tracker=0
debug.sf.enable_gl_backpressure=0
debug.sf.enable_hwc_vds=0
debug.sf.predict_hwc_composition_strategy=0
debug.sf.recomputecrop=0
debug.sf.treat_170m_as_sRGB=1
debug.sf.latch_unsignaled=0
#debug.sf.frame_rate_multiple_threshold=90
debug.sf.use_phase_offsets_as_durations=1
debug.sf.late.sf.duration=10500000
debug.sf.late.app.duration=16600000
debug.sf.early.sf.duration=16600000
debug.sf.early.app.duration=16600000
debug.sf.earlyGl.sf.duration=16600000
debug.sf.earlyGl.app.duration=16600000
debug.graphics.game_default_frame_rate.disabled=true
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.primary_display_orientation=ORIENTATION_0
ro.surface_flinger.protected_contents=true
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.set_idle_timer_ms=100
ro.surface_flinger.set_touch_timer_ms=200
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.use_color_management=true
service.sf.prime_shader_cache=0

# Misc
persist.vendor.mdlog.flush_log_ratio=72340194296137244
persist.vendor.pms_removable=1
persist.vendor.vzw_device_type=0
ro.mediatek.version.branch=alps-mp-s0.mssi1.tc16sp-pr6
ro.mtk_key_manager_support=1
ro.support_one_handed_mode=true

# WiFi
mediatek.wlan.ctia=0
ro.mediatek.wlan.p2p=1
ro.mediatek.wlan.wsc=1
wifi.direct.interface=p2p0
wifi.interface=wlan0
wifi.supplicant_scan_interval=15
wifi.tethering.interface=ap0
persist.vendor.wfc.sys_wfc_support=1
persist.data.iwlan.ipsec.ap=1

# USB
ro.sys.usb.bicr=no
ro.sys.usb.charging.only=yes
ro.sys.usb.mtp.whql.enable=0
ro.sys.usb.storage.type=mtp
sys.usb.mtp.batchcancel=1

# ADB
persist.service.debuggable=1
persist.adb.nonblocking_ffs=0
persist.service.adb.enable=1
persist.sys.usb.config=mtp,adb

# ScrollOptimizer
persist.sys.perf.scroll_opt=true
persist.sys.perf.scroll_opt.heavy_app=1

# Zygote
ro.zygote.preload.enable=0
zygote.critical_window.minute=10

# Radio
persist.sys.radio.force_lte_ca=true
persist.radio.hvolte.enable=1
persist.radio.multisim.config=dsds
persist.vendor.radio.telecom.vibrate=0
ro.telephony.sim.count=2

# Fastbootd
ro.fastbootd.available=true

# GPU Performance
ro.mtk_gpu_optimizations=1
ro.mtk_perf_dds_cpu=1

# Media
drm.service.enabled=true
media.stagefright.thumbnail.prefer_hw_codecs=true
persist.mm.enable.prefetch=true
ro.min_pointer_dur=8
ro.mediaserver.64b.enable=true
debug.stagefright.c2inputsurface=-1
debug.media.codec2=2

# Storage
persist.sys.fuse.passthrough.enable=true

# IPO
sys.ipo.disable=1
sys.ipo.pwrdncap=2

# iorapd
ro.iorapd.enable=false

# System properties
ro.product.property_source_order=odm,vendor,product,system_ext,system

# InfinityX phoneinfo props
ro.infinity.battery=5000 mAh
ro.infinity.camera=48MP + 8MP + 2MP + 2MP
ro.infinity.display=1080 x 2400, 90Hz
ro.infinity.soc=Mediatek Helio G95
